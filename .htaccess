# ==============================================================================
# HOTEL DESTIN - HTACCESS CONFIGURATION (CLEAN URLS, HTTPS & SECURITY)
# ==============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Redirect www to non-www canonical (https://hoteldestin.in)
    RewriteCond %{HTTP_HOST} ^www\.hoteldestin\.in$ [NC]
    RewriteRule ^(.*)$ https://hoteldestin.in%{REQUEST_URI} [R=301,L]

    # 2. Force HTTPS for hoteldestin.in
    RewriteCond %{HTTP_HOST} ^hoteldestin\.in$ [NC]
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
    RewriteRule ^(.*)$ https://hoteldestin.in%{REQUEST_URI} [R=301,L]

    # 3. 301 Redirect /index.php or /index to clean root / (Live domain only)
    RewriteCond %{HTTP_HOST} ^(www\.)?hoteldestin\.in$ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ /index(\.php)?[?\s] [NC]
    RewriteRule ^index(\.php)?$ / [R=301,L]

    # 4. Clean Room Detail URLs: /rooms/deluxe-room -> room-detail.php?room=deluxe-room
    RewriteRule ^rooms/assets/(.*)$ assets/$1 [L]
    RewriteRule ^rooms/([a-zA-Z0-9_-]+)/?$ room-detail.php?room=$1 [QSA,L]

    # 5. Support Clean Extensionless URLs (internally maps /page to page.php)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [QSA,L]
</IfModule>

# Security: Prevent Access to Sensitive Files (.sql, .log, .env, etc.)
<FilesMatch "(\.sql|\.log|\.env|\.git)$">
    Require all denied
</FilesMatch>

# Enable Gzip / Brotli Compression for Fast Page Loads
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript
</IfModule>
